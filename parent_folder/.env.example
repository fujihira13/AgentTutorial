# 一般設定
GOOGLE_API_KEY=your_google_api_key_here

# 4コマ漫画エージェント設定
# 実際のAPI（課金/クレジットが発生）を使用する場合は 'true' に設定し、モック実装を使用する場合は 'false' に設定してください
USE_REAL_IMAGE_GEN=false
USE_REAL_TTS=false

# オプション: 実際のAPIキー（GOOGLE_API_KEYと異なる場合や他のサービスに必要な場合）
# OPENAI_API_KEY=sk-...

# Google Cloud TTS 設定 (レガシー/Cloud TTS API)
# Gemini 2.5 Pro Preview TTS を使用する場合（GOOGLE_API_KEY を使用）は不要です
# GOOGLE_TTS_API_KEY=...
