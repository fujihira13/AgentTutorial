# 一般設定
GOOGLE_API_KEY=your_google_api_key_here

# 4コマ漫画エージェント設定
# 実際のAPI（課金/クレジットが発生）を使用する場合は 'true' に設定し、モック実装を使用する場合は 'false' に設定してください
USE_REAL_STORY_GEN=true
USE_REAL_IMAGE_GEN=false
USE_REAL_TTS=false

# 出力先 (相対パスの場合はプロジェクトルート基準)
COMIC_OUTPUT_DIR=output

# モデル設定
COMIC_STORY_MODEL=models/gemini-3-pro-preview
COMIC_IMAGE_MODEL=models/nano-banana-pro-preview
COMIC_TTS_MODEL=gemini-2.5-pro-preview-tts

# 通信設定
COMIC_HTTP_TIMEOUT_SECONDS=60
COMIC_API_MAX_RETRIES=2
COMIC_API_RETRY_BACKOFF_SECONDS=1.5
COMIC_STORY_VALIDATION_MAX_RETRIES=2

# 警告抑制 (必要な場合のみ)
COMIC_SUPPRESS_WARNINGS=false

# オプション: 実際のAPIキー（GOOGLE_API_KEYと異なる場合や他のサービスに必要な場合）
# OPENAI_API_KEY=sk-...

# Google Cloud TTS 設定 (レガシー/Cloud TTS API)
# Gemini 2.5 Pro Preview TTS を使用する場合（GOOGLE_API_KEY を使用）は不要です
# GOOGLE_TTS_API_KEY=...
