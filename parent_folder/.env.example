# General Settings
GOOGLE_API_KEY=your_google_api_key_here

# Comic Agent Configuration
# Set to 'true' to use real APIs (costs money/credits), 'false' for mock implementation
USE_REAL_IMAGE_GEN=false
USE_REAL_TTS=false

# Optional: Real API Keys (if different from GOOGLE_API_KEY or needed for other services)
# OPENAI_API_KEY=sk-...

# Optional: Real API Keys (if different from GOOGLE_API_KEY or needed for other services)
# OPENAI_API_KEY=sk-...

# Google Cloud TTS Settings (Legacy/Cloud TTS API)
# Not required if using Gemini 2.5 Pro Preview TTS (uses GOOGLE_API_KEY)
# GOOGLE_TTS_API_KEY=...
